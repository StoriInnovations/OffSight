# Homebrew cask for OffSight. Generated by scripts/release-homebrew.sh from this template;
# the release workflow pushes the result to the tap (astatine-/homebrew-offsight).
cask "offsight" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/astatine-/offsight/releases/download/v#{version}/OffSight-#{version}.zip"
  name "OffSight"
  desc "Software camera shutter: meeting apps see a placeholder until you approve"
  homepage "https://github.com/astatine-/offsight"

  depends_on macos: ">= :ventura"

  app "OffSight.app"

  uninstall launchctl: "com.storiinnovations.offsight.agent",
            quit:      "com.storiinnovations.offsight"

  zap trash: [
    "~/Library/Containers/com.storiinnovations.offsight",
    "~/Library/Group Containers/83QJANVRBL.com.storiinnovations.offsight",
  ]

  caveats <<~EOS
    Open OffSight and allow its camera extension when macOS asks, then choose
    "OffSight Camera" in your meeting apps. Before uninstalling, remove the camera
    extension in OffSight › Settings › Advanced › Remove.
    OffSight is open source and provided as is, without warranty or support.
  EOS
end
